# ── Ƙura Alert environment ───────────────────────────────────────────────────
# Copy to .env for the API. Next.js reads apps/web/.env.local separately.
#   cp .env.example .env

# Backend (services/api)
KURA_CACHE_TTL=1800              # seconds a live forecast stays cached
# KURA_INGEST_KEY=               # shared key for the Arduino node.
#                                 # Unset/blank = local requests only (127.0.0.1/::1).
#                                 # Set a strong value before exposing the API.
# KURA_DATA_DIR=./data           # where thresholds, cache and SQLite live
# KURA_DB_PATH=./data/kura.db
# KURA_THRESHOLDS=./data/thresholds.json

# Frontend (apps/web) — also put these in apps/web/.env.local
KURA_API_URL=http://127.0.0.1:8000
KURA_FETCH_TIMEOUT=15000         # ms before the UI falls back to bundled JSON
